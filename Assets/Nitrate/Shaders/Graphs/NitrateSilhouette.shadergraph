{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "0398b3ba22cbf1a5e3d8788d92fb6b07",
    "m_Title": "Vertex colour",
    "m_Content": "Vertex colour carries the wind response, written by the procedural generators.\n\nR = stiffness: 1 is rigid, 0 is a free tip.\nG = per-blade phase, so neighbouring blades do not flutter in unison.\n\nMeshes without vertex colours read white, so they stay rigid.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -20.0,
        "y": -250.0,
        "width": 340.0,
        "height": 210.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

